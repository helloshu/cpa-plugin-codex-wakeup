diff --git a/src/features/plugins/codexWakeupBridge.ts b/src/features/plugins/codexWakeupBridge.ts
new file mode 100644
index 0000000..b4f9ae8
--- /dev/null
+++ b/src/features/plugins/codexWakeupBridge.ts
@@ -0,0 +1,84 @@
+export interface WakeupRequest {
+  id: number;
+  path: string;
+  method: string;
+  data?: unknown;
+}
+
+const routes: Record<string, readonly string[]> = {
+  overview: ['GET'],
+  accounts: ['GET'],
+  preview: ['POST'],
+  tasks: ['GET', 'POST', 'PUT', 'PATCH', 'DELETE'],
+  'save-tasks': ['POST'],
+  wake: ['POST'],
+  history: ['GET'],
+  diagnostics: ['GET'],
+};
+
+export function parseWakeupRequest(value: unknown): WakeupRequest | null {
+  if (!value || typeof value !== 'object') return null;
+  const input = value as Record<string, unknown>;
+  if (!Number.isSafeInteger(input.id) || Number(input.id) < 1) return null;
+  if (typeof input.path !== 'string' || typeof input.method !== 'string') return null;
+  const [route, query, extra] = input.path.split('?');
+  if (extra !== undefined || !Object.prototype.hasOwnProperty.call(routes, route)) return null;
+  if (!routes[route].includes(input.method)) return null;
+  if (query !== undefined) {
+    if (route !== 'history' || !/^limit=[1-9][0-9]{0,2}$/.test(query)) return null;
+    if (Number(query.slice(6)) > 300) return null;
+  }
+  let data: unknown;
+  if (input.body !== undefined) {
+    if (input.method === 'GET' || typeof input.body !== 'string' || input.body.length > 1 << 20) {
+      return null;
+    }
+    try {
+      data = JSON.parse(input.body);
+    } catch {
+      return null;
+    }
+  }
+  // Construct the path ourselves; never pass a child-selected URL or headers.
+  return { id: Number(input.id), path: '/codex-wakeup/' + input.path, method: input.method, data };
+}
+
+export function serveWakeupPort(
+  port: MessagePort,
+  request: (input: WakeupRequest) => Promise<unknown>,
+  isActive: () => boolean
+): () => void {
+  let closed = false;
+  const pending = new Set<number>();
+  const close = () => {
+    closed = true;
+    port.onmessage = null;
+    port.close();
+  };
+  port.onmessage = async (event: MessageEvent<unknown>) => {
+    if (closed || !isActive()) {
+      close();
+      return;
+    }
+    const input = parseWakeupRequest(event.data);
+    if (!input || pending.has(input.id) || pending.size >= 16) return;
+    pending.add(input.id);
+    try {
+      const result = await request(input);
+      if (!closed && isActive()) port.postMessage({ id: input.id, ok: true, result });
+    } catch (error) {
+      // Do not serialize Axios config, headers, or request objects to the child.
+      if (!closed && isActive()) {
+        port.postMessage({
+          id: input.id,
+          ok: false,
+          error: error instanceof Error ? error.message : 'request_failed',
+        });
+      }
+    } finally {
+      pending.delete(input.id);
+    }
+  };
+  port.start();
+  return close;
+}
