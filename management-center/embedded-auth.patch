@@ -0,0 +1,24 @@
+import { apiClient } from './client';
+import type { WakeupRequest } from '@/features/plugins/codexWakeupBridge';
+
+export const codexWakeupApi = {
+  page: (signal: AbortSignal) =>
+    apiClient.get<string>('/codex-wakeup/ui', { responseType: 'text', signal }),
+  request: ({ path, method, data }: WakeupRequest, signal: AbortSignal): Promise<unknown> => {
+    const config = { signal, timeout: 120_000 };
+    switch (method) {
+      case 'GET':
+        return apiClient.get(path, config);
+      case 'POST':
+        return apiClient.post(path, data, config);
+      case 'PUT':
+        return apiClient.put(path, data, config);
+      case 'PATCH':
+        return apiClient.patch(path, data, config);
+      case 'DELETE':
+        return apiClient.delete(path, { ...config, data });
+      default:
+        return Promise.reject(new Error('Unsupported plugin method'));
+    }
+  },
+};
diff --git a/tests/codexWakeupBridge.test.ts b/tests/codexWakeupBridge.test.ts
