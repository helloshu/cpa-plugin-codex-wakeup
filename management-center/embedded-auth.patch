+import { useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { EmptyState } from '@/components/ui/EmptyState';
+import { codexWakeupApi } from '@/services/api/codexWakeup';
+import { useAuthStore } from '@/stores';
+import { serveWakeupPort } from './codexWakeupBridge';
+import styles from './PluginResourcePage.module.scss';
+
+interface FrameSession {
+  id: number;
+  apiBase: string;
+  managementKey: string;
+  active: () => boolean;
+  connect: (frame: Window) => void;
+}
+
+export function CodexWakeupFrame({ title }: { title: string }) {
+  const { t } = useTranslation();
+  const apiBase = useAuthStore((state) => state.apiBase);
+  const managementKey = useAuthStore((state) => state.managementKey);
+  const connectionStatus = useAuthStore((state) => state.connectionStatus);
+  const isAuthenticated = useAuthStore((state) => state.isAuthenticated);
+  const [document, setDocument] = useState<{ html: string; session: FrameSession } | null>(null);
+  const [failed, setFailed] = useState(false);
+  const current = useRef<FrameSession | null>(null);
+  const generation = useRef(0);
+
+  useEffect(() => {
+    if (!isAuthenticated || connectionStatus !== 'connected' || !managementKey) return;
+    const abort = new AbortController();
+    let closePort = () => {};
+    let connected = false;
+    const session: FrameSession = {
+      id: ++generation.current,
+      apiBase,
+      managementKey,
+      active: () => {
+        const state = useAuthStore.getState();
+        return (
+          !abort.signal.aborted &&
+          state.isAuthenticated &&
+          state.connectionStatus === 'connected' &&
+          state.apiBase === apiBase &&
+          state.managementKey === managementKey
+        );
+      },
+      connect: (frame) => {
+        closePort();
+        // Never transfer a new capability after the child navigates away
+        // from the authenticated srcdoc that was loaded for this session.
+        if (connected) {
+          abort.abort();
+          setFailed(true);
+          return;
+        }
+        connected = true;
+        const channel = new MessageChannel();
+        closePort = serveWakeupPort(
+          channel.port1,
+          (input) => codexWakeupApi.request(input, abort.signal),
+          session.active
+        );
+        // The sandbox has an opaque origin. Transfer only a restricted port
+        // to this exact frame, never a management key or a stored credential.
+        frame.postMessage({ type: 'codex-wakeup:connect', version: 1 }, '*', [channel.port2]);
+      },
+    };
+    current.current = session;
+    const stop = () => {
+      abort.abort();
+      closePort();
+    };
+    // Subscribe synchronously: cancel old requests before another connection
+    // can reuse the global API client, including during an in-flight login.
+    const unsubscribe = useAuthStore.subscribe(() => {
+      if (!session.active()) stop();
+    });
+    void codexWakeupApi.page(abort.signal).then(
+      (html) => {
+        if (session.active()) {
+          setDocument({ html, session });
+          setFailed(false);
+        }
+      },
+      () => {
+        if (session.active()) setFailed(true);
+      }
+    );
+    return () => {
+      unsubscribe();
+      stop();
+      if (current.current === session) current.current = null;
+    };
+  }, [apiBase, managementKey, connectionStatus, isAuthenticated]);
+
+  const ready =
+    document &&
+    document.session.apiBase === apiBase &&
+    document.session.managementKey === managementKey &&
+    document.session.active();
+
+  if (!ready) {
+    return (
+      <div className={styles.stateShell}>
+        {failed ? (
+          <EmptyState
+            title={t('plugin_resource.unavailable')}
+            description={t('plugin_resource.load_failed')}
+          />
+        ) : (
+          <div className={styles.statusPanel}>{t('common.loading')}</div>
+        )}
+      </div>
+    );
+  }
+
+  return (
+    <iframe
+      key={document.session.id}
+      className={styles.frame}
+      srcDoc={document.html}
+      title={title}
+      sandbox="allow-scripts"
+      referrerPolicy="no-referrer"
+      onLoad={(event) => {
+        const session = document.session;
+        if (current.current !== session || !session.active()) return;
+        const frame = event.currentTarget.contentWindow;
+        if (frame) session.connect(frame);
+      }}
+    />
+  );
+}
