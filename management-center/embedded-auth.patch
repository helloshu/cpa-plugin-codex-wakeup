+++ b/tests/codexWakeupBridge.test.ts
@@ -0,0 +1,104 @@
+import { describe, expect, test } from 'bun:test';
+import { parseWakeupRequest, serveWakeupPort } from '../src/features/plugins/codexWakeupBridge';
+
+describe('Codex wakeup management bridge', () => {
+  test('limits requests to the plugin methods and namespace', () => {
+    for (const path of [
+      '../config',
+      '/config',
+      '//example.com',
+      'https://example.com',
+      'tasks/../../config',
+      'tasks%2f..%2fconfig',
+      'tasks#x',
+      'tasks?x=1',
+      'history?limit=301',
+      'history?limit=1&x=2',
+      'history??limit=1',
+      '__proto__',
+    ]) {
+      expect(parseWakeupRequest({ id: 1, path, method: 'GET' })).toBeNull();
+    }
+    expect(parseWakeupRequest({ id: 1, path: 'wake', method: 'GET' })).toBeNull();
+    expect(parseWakeupRequest({ id: 1, path: 'tasks', method: 'TRACE' })).toBeNull();
+    expect(parseWakeupRequest({ id: 1, path: 'tasks', method: 'POST', body: '{' })).toBeNull();
+    expect(parseWakeupRequest({ id: 1, path: 'tasks', method: 'GET', body: '{}' })).toBeNull();
+    expect(parseWakeupRequest({ id: 1, path: 'history?limit=50', method: 'GET' })?.path).toBe(
+      '/codex-wakeup/history?limit=50'
+    );
+    const parsed = parseWakeupRequest({
+      id: 2,
+      path: 'tasks',
+      method: 'POST',
+      body: '{"task":{"name":"<test>"}}',
+      headers: { Authorization: 'forged' },
+      baseURL: 'https://example.com',
+    });
+    expect(parsed).toEqual({
+      id: 2,
+      path: '/codex-wakeup/tasks',
+      method: 'POST',
+      data: { task: { name: '<test>' } },
+    });
+  });
+
+  test('proxies results without disclosing error request objects', async () => {
+    const { port1, port2 } = new MessageChannel();
+    const close = serveWakeupPort(
+      port1,
+      async (input) => {
+        if (input.id === 1) return { tasks: [] };
+        throw Object.assign(new Error('denied'), { config: { secret: 'test-management-secret' } });
+      },
+      () => true
+    );
+    try {
+      const receive = () =>
+        new Promise<unknown>((resolve) => {
+          port2.onmessage = (e) => resolve(e.data);
+        });
+      let reply = receive();
+      port2.postMessage({ id: 1, path: 'tasks', method: 'GET' });
+      expect(await reply).toEqual({ id: 1, ok: true, result: { tasks: [] } });
+      reply = receive();
+      port2.postMessage({ id: 2, path: 'tasks', method: 'GET' });
+      expect(await reply).toEqual({ id: 2, ok: false, error: 'denied' });
+    } finally {
+      close();
+      port2.close();
+    }
+  });
+
+  test('drops responses from an old login and rejects calls after logout', async () => {
+    const { port1, port2 } = new MessageChannel();
+    let active = true;
+    let calls = 0;
+    let finish!: (value: unknown) => void;
+    const close = serveWakeupPort(
+      port1,
+      async () => {
+        calls += 1;
+        return new Promise((resolve) => {
+          finish = resolve;
+        });
+      },
+      () => active
+    );
+    const replies: unknown[] = [];
+    port2.onmessage = (event) => replies.push(event.data);
+    try {
+      port2.postMessage({ id: 1, path: 'tasks', method: 'GET' });
+      for (let i = 0; i < 100 && !finish; i += 1) await Bun.sleep(1);
+      expect(calls).toBe(1);
+      active = false;
+      finish({ tasks: ['old-session'] });
+      port2.postMessage({ id: 2, path: 'tasks', method: 'GET' });
+      await Bun.sleep(20);
+      expect(calls).toBe(1);
+      expect(replies).toEqual([]);
+    } finally {
+      close();
+      port2.close();
+    }
+  });
+});
